# ============================================================
# LocBeauté — Variables d'environnement
# Copier ce fichier en .env (jamais commité) et remplir les valeurs
# ============================================================

# ── Supabase (obligatoire) ───────────────────────────────────────
# Trouvez ces valeurs dans : Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...votre_anon_key

# ── URL de l'application (obligatoire en production) ────────────
# Utilisé pour les redirections email (confirmation, reset password)
VITE_APP_URL=https://locbeaute.com

# ── Stripe (optionnel — active les vrais paiements) ─────────────
# Clé PUBLIQUE uniquement ici. La clé secrète va dans Supabase Secrets.
# Sans cette variable, les paiements fonctionnent en mode simulation.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...votre_cle_publique

# ── Google Analytics (optionnel) ────────────────────────────────
# Pour activer le tracking GA4
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================
# DÉPLOIEMENT VERCEL
# Ajouter ces variables dans : Vercel Dashboard → Settings → Environment Variables
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#   VITE_APP_URL
#   VITE_STRIPE_PUBLISHABLE_KEY  (si Stripe activé)
#
# SUPABASE EDGE FUNCTIONS (pour Stripe)
# Ajouter dans : Supabase Dashboard → Edge Functions → Secrets
#   STRIPE_SECRET_KEY=sk_live_...
# Puis déployer : supabase functions deploy create-payment-intent
# ============================================================
